# Supplier Hub — Environment Variables
# Copy this to .env for local dev, or configure in Coolify dashboard

# ─── Database ────────────────────────────────────────────
# PostgreSQL (production / Coolify):
#   Coolify will auto-generate the PostgreSQL DB URL.
#   Both variables can point to the same database; all tables coexist.
# DATABASE_URL=postgresql://user:password@host:5432/supplier_hub
# PIPELINE_DATABASE_URL=postgresql://user:password@host:5432/supplier_hub
#
# SQLite (local dev — default, no env needed):
#   Application auto-creates SQLite files under backend/db/

# ─── Security ────────────────────────────────────────────
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRY=3600

# ─── AI / Lab Report Extraction (optional) ───────────────
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:4b

# ─── Base Directory ──────────────────────────────────────
# BASE_DIR=/app  # auto-set in Docker; only override for custom layouts